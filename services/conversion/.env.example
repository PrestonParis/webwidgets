CONVERSION_API_PORT=4010
DATABASE_URL=postgres://conversion:conversion@localhost:5433/conversion
REDIS_URL=redis://localhost:6380
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=webwidgets-conversions
S3_FORCE_PATH_STYLE=true
CONVERSION_MAX_FILE_BYTES=52428800

# Optional: set a shared secret to require authentication on all API routes.
# The WebWidgets proxy injects this header automatically when configured.
# Leave empty to disable auth (safe for local dev).
CONVERSION_API_KEY=

# S3/MinIO CORS (optional — set to true to push CORS rules to the bucket on startup)
# S3_CONFIGURE_CORS=false
# S3_ALLOWED_ORIGINS=https://yourdomain.com

# Job retention and cleanup
# CONVERSION_OBJECT_TTL_DAYS=7
# CLEANUP_INTERVAL_MS=3600000

# Rate limiting (POST /v1/jobs, per IP, in-memory)
# CONVERSION_RATE_LIMIT_MAX=20
# CONVERSION_RATE_LIMIT_WINDOW_MS=60000

# Worker tuning (apps/worker-docs only)
# Number of parallel conversions. Each LibreOffice instance needs ~512 MB RAM.
WORKER_CONCURRENCY=2
# Lock duration in ms. Jobs not renewed within this window are considered stalled.
# Must exceed the slowest expected conversion (default 5 min = 300000).
WORKER_LOCK_DURATION_MS=300000
# Maximum output file size in bytes (default 100 MB).
# CONVERSION_MAX_OUTPUT_BYTES=104857600
