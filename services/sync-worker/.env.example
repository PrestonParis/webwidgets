SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-in-secret-store
REDIS_URL=redis://localhost:6379

# Dark deployment defaults. Do not enable provider work until cutover.
V1_QUEUES_ENABLED=true
WORKER_DRY_RUN=true
EMAIL_SYNC_ENABLED=false
SCHEDULE_OWNER=vercel

HEALTH_PORT=10000
HEARTBEAT_INTERVAL_MS=30000
JOB_TIMEOUT_MS=120000
SHUTDOWN_TIMEOUT_MS=110000
SYNC_BATCH_SIZE=50
SYNC_INTERVAL_MINUTES=10

# Required only when EMAIL_SYNC_ENABLED=true.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Required only for the one-off runtime probe command.
SMOKE_USER_ID=
SMOKE_IDEMPOTENCY_KEY=
