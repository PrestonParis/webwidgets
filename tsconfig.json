{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./apps/web/*"]
    }
  },
  "include": [
    "scripts/**/*.ts",
    "tools/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "eslint.config.mjs"
  ],
  "exclude": ["node_modules", "apps", "services", "packages", "infra"]
}
