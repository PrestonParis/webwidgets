{
  "name": "webwidgets",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run clean:next-cache && cd apps/web && NEXT_DISABLE_SENTRY=1 NEXT_PUBLIC_DISABLE_SENTRY=1 NODE_OPTIONS=--max-old-space-size=2048 next dev",
    "dev:web:sentry": "npm run clean:next-cache && cd apps/web && NODE_OPTIONS=--max-old-space-size=2048 next dev",
    "dev:api": "cd services/conversion && npm run dev:api",
    "dev:sync": "cd apps/sync-worker && npm run dev",
    "dev:infra": "open -a Docker && until docker info > /dev/null 2>&1; do sleep 1; done && (supabase status > /dev/null 2>&1 || supabase start || true) && until supabase status > /dev/null 2>&1; do sleep 2; done && npm run conversion:up",
    "dev:full": "npm run dev:infra && concurrently -n web,api,sync -c cyan,magenta,yellow \"npm run dev:web\" \"npm run dev:api\" \"npm run dev:sync\"",
    "env:cloud": "cp apps/web/.env.cloud apps/web/.env.local && echo '✓ Switched to cloud Supabase (dev project). Run: npm run dev'",
    "env:docker": "cp apps/web/.env.local.docker apps/web/.env.local && echo '✓ Switched to local Docker Supabase. Run: npm run dev:full'",
    "env:status": "grep NEXT_PUBLIC_SUPABASE_URL apps/web/.env.local | sed 's/NEXT_PUBLIC_SUPABASE_URL=/Supabase target: /'",
    "dev:all": "concurrently \"npm run dev:web\" \"npm run dev:ml\"",
    "clean:next-cache": "rm -rf apps/web/.next",
    "dev:ml": "services/ml_service/venv/bin/uvicorn --app-dir services/ml_service main:app --port 8000",
    "dev:ml:reload": "services/ml_service/venv/bin/uvicorn --app-dir services/ml_service main:app --port 8000 --reload",
    "py:install": "services/ml_service/venv/bin/python -m pip install -r services/ml_service/requirements-dev.txt",
    "py:format": "services/ml_service/venv/bin/python -m ruff format services/ml_service",
    "py:format:check": "services/ml_service/venv/bin/python -m ruff format services/ml_service --check",
    "py:lint": "services/ml_service/venv/bin/python -m ruff check services/ml_service",
    "py:lint:fix": "services/ml_service/venv/bin/python -m ruff check services/ml_service --fix",
    "py:typecheck": "services/ml_service/venv/bin/python -m basedpyright services/ml_service",
    "py:security": "services/ml_service/venv/bin/python -m bandit -r services/ml_service -x services/ml_service/tests,services/ml_service/venv,services/ml_service/.venv",
    "py:deps": "services/ml_service/venv/bin/python -m deptry services/ml_service --requirements-files services/ml_service/requirements.txt --requirements-files-dev services/ml_service/requirements-dev.txt --per-rule-ignores 'DEP002=uvicorn|python-dotenv|pytest-asyncio|httpx'",
    "py:deadcode": "services/ml_service/venv/bin/python -m vulture services/ml_service --exclude '*/tests/*,*/venv/*,*/.venv/*' --ignore-decorators '@app.*,@router.*,@*.validator,@field_validator' --ignore-names cls --min-confidence 80",
    "py:smells": "tsx scripts/linting/python-smells.ts services/ml_service",
    "py:test": "services/ml_service/venv/bin/python -m pytest services/ml_service/tests",
    "py:check": "npm run py:format:check && npm run py:lint && npm run py:typecheck && npm run py:security && npm run py:deps && npm run py:deadcode && npm run py:smells && npm run py:test",
    "py:fix": "npm run py:format && npm run py:lint:fix",
    "conversion:up": "open -a Docker && until docker info > /dev/null 2>&1; do sleep 1; done && cd services/conversion && docker compose -f infra/docker/docker-compose.yml up -d redis postgres minio createbucket worker_docs",
    "build": "cd apps/web && NODE_OPTIONS=--max-old-space-size=8192 next build",
    "start": "cd apps/web && next start",
    "lint": "cd apps/web && next lint",
    "analyze": "tsx scripts/analyze.ts",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "husky",
    "check": "node --max-old-space-size=4096 $(which tsx) scripts/linting/index.ts",
    "linting:lint": "tsx scripts/linting/index.ts --lint-only",
    "linting:ts": "tsx scripts/linting/index.ts --ts-only",
    "linting:smells": "tsx scripts/linting/index.ts --smells-only",
    "linting:stats": "tsx scripts/linting/index.ts --stats-only",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:attached": "E2E_MODE=attached playwright test",
    "test:e2e:managed": "E2E_MODE=managed playwright test",
    "test:e2e:smoke": "playwright test tests/e2e/traversal/route-traversal.spec.ts --grep \"traverse dashboard route\"",
    "test:traversal": "playwright test tests/e2e/traversal",
    "test:widgets": "playwright test tests/e2e/widgets",
    "test:dashboard": "playwright test tests/e2e/dashboard",
    "test:performance": "playwright test tests/e2e/performance",
    "test:hydration": "playwright test tests/e2e/hydration",
    "test:runtime": "playwright test tests/e2e/traversal tests/e2e/widgets tests/e2e/hydration",
    "dev:test": "concurrently \"npm run dev:web\" \"wait-on http://localhost:3000 && npm run test:e2e:attached\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@aws-sdk/client-s3": "^3.1049.0",
    "@aws-sdk/s3-request-presigner": "^3.1049.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/generative-ai": "^0.24.1",
    "@hookform/resolvers": "^5.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@mozilla/readability": "^0.6.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@sentry/nextjs": "^10.53.1",
    "@supabase/auth-helpers-nextjs": "^0.15.0",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.100.0",
    "@tanstack/react-query": "^5.100.11",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.25",
    "@tiptap/extension-character-count": "^3.22.3",
    "@tiptap/extension-placeholder": "^3.22.3",
    "@tiptap/pm": "^3.22.3",
    "@tiptap/react": "^3.22.3",
    "@tiptap/starter-kit": "^3.22.3",
    "@types/dockerode": "^4.0.1",
    "@types/file-saver": "^2.0.7",
    "@types/papaparse": "^5.5.2",
    "@types/sanitize-html": "^2.16.1",
    "@uiw/react-json-view": "^2.0.0-alpha.42",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.10.2",
    "bottleneck": "^2.19.5",
    "bullmq": "^5.76.10",
    "chess.js": "^1.4.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3": "^7.9.0",
    "date-fns": "^4.2.1",
    "dockerode": "^5.0.0",
    "drizzle-orm": "^0.45.2",
    "drizzle-zod": "^0.8.3",
    "equine": "^1.0.0-alpha.0",
    "file-saver": "^2.0.5",
    "flexsearch": "^0.8.212",
    "framer-motion": "^12.38.0",
    "googleapis": "^171.4.0",
    "he": "^1.2.0",
    "ioredis": "^5.10.1",
    "lucide-react": "^1.8.0",
    "marked": "^18.0.4",
    "neverthrow": "^8.2.0",
    "next": "^16.2.3",
    "openai": "^6.38.0",
    "p-limit": "^7.3.0",
    "papaparse": "^5.5.3",
    "pdf-lib": "^1.17.1",
    "pino": "^10.3.1",
    "playwright": "^1.59.1",
    "plotly.js": "^3.4.0",
    "posthog-js": "^1.374.2",
    "posthog-node": "^5.34.6",
    "prom-client": "^15.1.3",
    "react": "19.2.3",
    "react-chessboard": "^5.10.0",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.76.0",
    "react-pdf": "^10.4.1",
    "react-plotly.js": "^2.6.0",
    "recharts": "^3.8.1",
    "rss-parser": "^3.13.0",
    "sanitize-html": "^2.17.4",
    "stripe": "^22.1.1",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.5.0",
    "three": "^0.184.0",
    "ts-pattern": "^5.9.0",
    "zod": "^4.4.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/d3": "^7.4.3",
    "@types/he": "^1.2.3",
    "@types/node": "^20",
    "@types/plotly.js": "^3.0.10",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "@vitest/coverage-v8": "^4.1.5",
    "autoprefixer": "^10.4.27",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.1.6",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
