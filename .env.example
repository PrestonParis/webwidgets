# ──────────────────────────────────────────────
# Supabase (local: supabase start; prod: Supabase dashboard)
# ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ──────────────────────────────────────────────
# Google OAuth  (used for Gmail + Calendar)
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Add http://localhost:54321/auth/v1/callback as an authorized redirect URI for local dev.
# ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback  # use prod URL (e.g. https://yourdomain.com/auth/callback) in production

# ──────────────────────────────────────────────
# Anthropic (email classification via Claude)
# platform.anthropic.com → API Keys
# ──────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ──────────────────────────────────────────────
# ML service  (Python FastAPI — deployed to Vercel)
# Local dev: http://localhost:8000 (docker-compose up or uvicorn)
# Production: https://your-ml-service.vercel.app
# ──────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8000

# ──────────────────────────────────────────────
# Sentry (error tracking)
# sentry.io → Your Project → Settings → Client Keys (DSN)
# SENTRY_ORG / SENTRY_PROJECT are only needed for source-map uploads at build time.
# ──────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# ──────────────────────────────────────────────
# Gmail push notifications (Pub/Sub)
# Google Cloud Console → Pub/Sub → Topics
# ──────────────────────────────────────────────
GMAIL_PUBSUB_TOPIC=projects/<project-id>/topics/gmail-notifications
GMAIL_WEBHOOK_TOKEN=   # openssl rand -hex 32

# ──────────────────────────────────────────────
# Secrets  (generate with: openssl rand -hex 32)
# ──────────────────────────────────────────────
CRON_SECRET=
METRICS_SECRET=

# ──────────────────────────────────────────────
# Observability
# ──────────────────────────────────────────────
ENVIRONMENT=development  # development | production
LOG_LEVEL=debug          # debug | info | warn | error

# ──────────────────────────────────────────────
# Lichess (chess game sync)
# lichess.org → Account → API Access Tokens
# ──────────────────────────────────────────────
LICHESS_API_TOKEN=
