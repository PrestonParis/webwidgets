# ──────────────────────────────────────────────
# App URL  (used for OAuth redirect URIs on the server side)
# Local dev: http://localhost:3000   Production: https://webwidgets.me
# ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ──────────────────────────────────────────────
# Supabase (local: supabase start; prod: Supabase dashboard)
# ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ──────────────────────────────────────────────
# Google OAuth  (used for Gmail + Calendar)
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Add http://localhost:54321/auth/v1/callback as an authorized redirect URI for local dev.
# ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback  # use prod URL (e.g. https://yourdomain.com/auth/callback) in production

# ──────────────────────────────────────────────
# Anthropic (email classification via Claude)
# platform.anthropic.com → API Keys
# ──────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ──────────────────────────────────────────────
# ML service  (authenticated Python FastAPI container)
# ML_SERVICE_TOKEN must match the value configured on the container.
# ──────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8000
# Governed external inference container (may be the same URL locally).
INFERENCE_SERVICE_URL=http://localhost:8000
ML_SERVICE_TOKEN=

# Durable briefing orchestration. WORKER_API_TOKEN must match Render.
WORKER_SERVICE_URL=http://localhost:10000
WORKER_API_TOKEN=

# ──────────────────────────────────────────────
# Go worker service (background infrastructure)
# Local dev: http://localhost:8081 (docker-compose up)
# Handles: analytics ingestion, async cache writes, event normalization
# ──────────────────────────────────────────────
GO_WORKER_URL=http://localhost:8081
GO_WORKER_ENABLED=false
GO_WORKER_TIMEOUT_MS=5000

# ──────────────────────────────────────────────
# Conversion service (services/conversion)
# The web app routes through /api/conversion (Next.js proxy) by default.
# CONVERSION_API_URL is server-only and used by the proxy to reach the service.
# Local dev: cd services/conversion && npm run dev:api  (port 4010)
# Run infra first: docker compose -f services/conversion/infra/docker/docker-compose.yml up -d
# Production: set CONVERSION_API_URL to your deployed conversion API URL (server-only, not exposed to browser)
# Set NEXT_PUBLIC_CONVERSION_API_URL only to bypass the proxy (e.g. for direct local testing).
# ──────────────────────────────────────────────
CONVERSION_API_URL=http://localhost:4010
NEXT_PUBLIC_CONVERSION_API_URL=

# ──────────────────────────────────────────────
# n8n workflow automation (server-only)
# n8n handles background ingestion, scheduled syncs, webhooks, and async enrichment.
# Do not expose these values to the browser.
# ──────────────────────────────────────────────
N8N_BASE_URL=
N8N_API_KEY=
N8N_WEBHOOK_SECRET=
N8N_WEBHOOK_USER_AGENT=
N8N_TIMEOUT_MS=10000

# ──────────────────────────────────────────────
# Sentry (error tracking)
# sentry.io → Your Project → Settings → Client Keys (DSN)
# SENTRY_ORG / SENTRY_PROJECT are only needed for source-map uploads at build time.
# ──────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# ──────────────────────────────────────────────
# Gmail push notifications (Pub/Sub)
# Google Cloud Console → Pub/Sub → Topics
# ──────────────────────────────────────────────
GMAIL_PUBSUB_TOPIC=projects/<project-id>/topics/gmail-notifications
GMAIL_WEBHOOK_TOKEN=   # openssl rand -hex 32

# ──────────────────────────────────────────────
# Secrets  (generate with: openssl rand -hex 32)
# ──────────────────────────────────────────────
CRON_SECRET=
METRICS_SECRET=

# ──────────────────────────────────────────────
# Observability
# ──────────────────────────────────────────────
ENVIRONMENT=development  # development | production
LOG_LEVEL=debug          # debug | info | warn | error

# ──────────────────────────────────────────────
# Lichess (chess game sync)
# lichess.org → Account → API Access Tokens
# ──────────────────────────────────────────────
LICHESS_API_TOKEN=

# ──────────────────────────────────────────────
# Stripe (billing / subscriptions)
# dashboard.stripe.com → Developers → API Keys
# Price IDs: dashboard.stripe.com → Products → (create Pro + Business products)
#   Each product needs a recurring monthly price; copy the price_xxx ID here.
# Webhook: dashboard.stripe.com → Webhooks → Add endpoint
#   URL: https://yourdomain.com/api/webhooks/stripe
#   Events: checkout.session.completed, customer.subscription.*
# ──────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOK_SECRET=whsec_
STRIPE_PRICE_PRO_MONTHLY=price_
STRIPE_PRICE_BUSINESS_MONTHLY=price_

# ──────────────────────────────────────────────
# AWS S3 (file uploads)
# AWS Console → IAM → Users → Create user with AmazonS3FullAccess (or scoped policy)
# AWS Console → S3 → Create bucket → enable CORS:
#   AllowedOrigins: ["*"] (restrict to your domain in production)
#   AllowedMethods: ["PUT"]
#   AllowedHeaders: ["*"]
# ──────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# ──────────────────────────────────────────────
# GitHub (developer activity widget)
# github.com → Settings → Developer settings → Personal access tokens
# Scopes: repo, read:org (classic token) or contents/pull_requests (fine-grained)
# TODO: replace with per-user OAuth when GitHub App flow is implemented.
# ──────────────────────────────────────────────
GITHUB_TOKEN=

# ──────────────────────────────────────────────
# Linear (project management)
# linear.app → Settings → API → Personal API keys
# TODO: replace with per-user OAuth when Linear OAuth flow is implemented.
# ──────────────────────────────────────────────
LINEAR_API_KEY=

# ──────────────────────────────────────────────
# Microsoft Graph (Outlook Mail, Calendar, OneDrive, Teams)
# portal.azure.com → App registrations → New registration
# Redirect URI: https://yourdomain.com/api/auth/microsoft/callback
# Scopes: Mail.Read, Calendars.Read, Files.Read, Tasks.Read, User.Read
# ──────────────────────────────────────────────
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# ──────────────────────────────────────────────
# Slack (inbox / notifications)
# api.slack.com/apps → New App → OAuth & Permissions
# Scopes: channels:history, im:history, users:read
# Redirect URI: https://yourdomain.com/auth/slack/callback
# ──────────────────────────────────────────────
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# ──────────────────────────────────────────────
# Notion (knowledge / documents)
# notion.so/my-integrations → New integration → Internal integration token
# ──────────────────────────────────────────────
NOTION_API_KEY=

# ──────────────────────────────────────────────
# Readwise (reading / research queue)
# readwise.io/access_token
# ──────────────────────────────────────────────
READWISE_API_KEY=

# ──────────────────────────────────────────────
# Bible (scripture.api.bible)
# scripture.api.bible → sign up → API key
# Free tier available; key goes in api-key header via server proxy
# ──────────────────────────────────────────────
BIBLE_API_KEY=

# ──────────────────────────────────────────────
# Plaid (bank/finance connections)
# dashboard.plaid.com → Developers → Keys
# Use sandbox environment for development.
# ──────────────────────────────────────────────
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# ──────────────────────────────────────────────
# Market data (finance widget)
# Finnhub: finnhub.io/dashboard → API key
# Alpha Vantage: alphavantage.co/support/#api-key (free tier available)
# ──────────────────────────────────────────────
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
